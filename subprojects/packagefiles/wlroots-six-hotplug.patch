@@ -48,6 +48,8 @@ struct wlr_session {
 	struct udev *udev;
 	struct udev_monitor *mon;
 	struct wl_event_source *udev_event;
+	int hotplug_fd;
+	struct wl_event_source *hotplug_event;
 
 	struct libseat *seat_handle;
 	struct wl_event_source *libseat_event;
