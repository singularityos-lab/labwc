+static void render_liquid(struct fx_gles_render_pass *pass,
+		struct fx_texture *texture, struct fx_render_blur_pass_options *fx_options) {
+	struct fx_render_texture_options *tex_options = &fx_options->tex_options;
+	struct fx_renderer *renderer = pass->buffer->renderer;
+	struct liquid_shader shader = renderer->shaders.liquid;
+	const struct wlr_box *box = tex_options->clip_box;
+	if (!box || box->width <= 0 || box->height <= 0) {
+		return;
+	}
+
+	struct fx_corner_fradii corners = tex_options->corners;
+	float radius = fmaxf(fmaxf(corners.top_left, corners.top_right),
+		fmaxf(corners.bottom_left, corners.bottom_right));
+	struct wlr_fbox src_fbox = {
+		.x = (double)box->x / texture->wlr_texture.width,
+		.y = (double)box->y / texture->wlr_texture.height,
+		.width = (double)box->width / texture->wlr_texture.width,
+		.height = (double)box->height / texture->wlr_texture.height,
+	};
+
+	push_fx_debug(renderer);
+	setup_blending(WLR_RENDER_BLEND_MODE_PREMULTIPLIED);
+	glUseProgram(shader.program);
+
+	glActiveTexture(GL_TEXTURE0);
+	glBindTexture(texture->target, texture->tex);
+	glTexParameteri(texture->target, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+	glTexParameteri(texture->target, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+
+	glUniform1i(shader.tex, 0);
+	glUniform4f(shader.uv_box, src_fbox.x, src_fbox.y,
+		src_fbox.width, src_fbox.height);
+	glUniform2f(shader.size, box->width, box->height);
+	glUniform1f(shader.radius, radius);
+	glUniform1f(shader.bezel, fx_options->liquid);
+	glUniform1f(shader.alpha, tex_options->base.alpha ? *tex_options->base.alpha : 1.0f);
+
+	set_proj_matrix(shader.proj, pass->projection_matrix, box);
+	set_tex_matrix(shader.tex_proj, WL_OUTPUT_TRANSFORM_NORMAL, &src_fbox);
+
+	render(box, tex_options->base.clip, shader.pos_attrib);
+
+	glBindTexture(texture->target, 0);
+	pop_fx_debug(renderer);
+}
+
