diff --git a/render/fx_renderer/shaders/liquid.frag b/render/fx_renderer/shaders/liquid.frag
new file mode 100644
index 0000000..edc52b9
--- /dev/null
+++ b/render/fx_renderer/shaders/liquid.frag
@@ -0,0 +1,55 @@
+#ifdef GL_FRAGMENT_PRECISION_HIGH
+precision highp float;
+#else
+precision mediump float;
+#endif
+
+varying vec2 v_texcoord;
+uniform sampler2D tex;
+
+uniform vec4 uv_box;
+uniform vec2 size;
+uniform float radius;
+uniform float bezel;
+uniform float alpha;
+
+float box_distance(vec2 p, vec2 half_size, float r) {
+	vec2 q = abs(p) - half_size + r;
+	return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
+}
+
+void main() {
+	vec2 half_size = size * 0.5;
+	vec2 p = (v_texcoord - uv_box.xy) / uv_box.zw * size - half_size;
+	float r = min(radius, min(half_size.x, half_size.y));
+	float d = box_distance(p, half_size, r);
+	float coverage = clamp(0.5 - d, 0.0, 1.0);
+	if (coverage <= 0.0) {
+		discard;
+	}
+
+	vec2 e = vec2(0.5, 0.0);
+	vec2 normal = vec2(
+		box_distance(p + e.xy, half_size, r) - box_distance(p - e.xy, half_size, r),
+		box_distance(p + e.yx, half_size, r) - box_distance(p - e.yx, half_size, r));
+	float normal_length = length(normal);
+	normal = normal_length > 0.0 ? normal / normal_length : vec2(0.0);
+
+	float width = min(bezel, min(half_size.x, half_size.y));
+	float rim = clamp(1.0 + d / max(width, 1.0), 0.0, 1.0);
+	float bend = 1.0 - sqrt(1.0 - rim * rim);
+	vec2 offset = -normal * bend * width / size * uv_box.zw;
+
+	vec3 color = vec3(
+		texture2D(tex, v_texcoord + offset * 1.06).r,
+		texture2D(tex, v_texcoord + offset).g,
+		texture2D(tex, v_texcoord + offset * 0.94).b);
+
+	float edge = 1.0 - smoothstep(0.0, 1.6, -d);
+	float light = max(dot(normal, normalize(vec2(-0.6, -1.0))), 0.0);
+	float shade = max(dot(normal, normalize(vec2(0.6, 1.0))), 0.0);
+	color += edge * (0.45 * light + 0.12 * shade);
+	color += bend * 0.06;
+
+	gl_FragColor = vec4(min(color, 1.0), 1.0) * coverage * alpha;
+}
